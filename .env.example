# Copy this file to .env and change the values. Never commit .env to Git.

# Long random string used to sign login tokens. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string

# First admin account (created on first start). You'll be asked to change the password after logging in.
ADMIN_EMAIL=you@yourcompany.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Your Name

# Frontend address(es) allowed to call the API, comma-separated
CORS_ORIGINS=http://localhost:3000

# Only needed when running the backend outside Docker
# DATABASE_URL=postgresql+psycopg://study:study@localhost:5432/study
